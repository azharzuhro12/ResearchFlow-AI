# ResearchFlow AI — backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# GLM API credential (the only paid API used by this project)
GLM_API_KEY=your_glm_api_key_here

# GLM model name available on your GLM API account (check your GLM console/docs)
GLM_MODEL=your_glm_model_name_here

# Optional: GLM API base URL (default: https://api.z.ai/api/anthropic,
# Anthropic Messages format). For Zhipu's OpenAI-compatible endpoint use
# https://open.bigmodel.cn/api/paas/v4 — but glm_service.py must then be
# adapted back to the chat-completions request/response shape.
# GLM_BASE_URL=https://api.z.ai/api/anthropic

# Optional: comma-separated allowed CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# Optional: Discord incoming-webhook URL for scheduled-research notifications
# (Step 8). Backend secret — never share it, never commit it. Leave as the
# placeholder to disable notifications; the research pipeline keeps working.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Optional: SQLite location (Step 9). Default: data/researchflow.db under the
# project root (inside the Docker volume when running via docker-compose).
# DATABASE_URL=sqlite:////app/data/researchflow.db

# Optional: IANA timezone used as the default for NEW schedules (Step 7).
# DEFAULT_SCHEDULE_TIMEZONE=Asia/Jakarta
